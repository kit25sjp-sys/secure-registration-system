# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# ─── Session ──────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# ─── JWT (Admin Panel) ───────────────────────────────────
JWT_SECRET=change-this-to-another-long-random-string

# ─── Email (Gmail SMTP) ───────────────────────────────────────
# Your Gmail address used to send OTP emails
EMAIL_USER=your-gmail@gmail.com
# 16-character App Password (no spaces)
# myaccount.google.com → Security → 2-Step Verification → App passwords
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM="SecureReg System" <your-gmail@gmail.com>

# ─── Google reCAPTCHA ─────────────────────────────────────
# Get keys from: https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=your-site-key-here
RECAPTCHA_SECRET_KEY=your-secret-key-here

# ─── Frontend ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
