# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# ─── Session ──────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-long-random-string-in-production

# ─── JWT (Admin Panel) ───────────────────────────────────
JWT_SECRET=change-this-to-another-long-random-string

# ─── Email (leave blank to use Ethereal demo SMTP) ────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="SecureReg System <noreply@securereg.com>"

# ─── Frontend ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
